{
    "name": "seadragon/laravel-log-alerts",
    "description": "Daily email summaries of recent Laravel application errors.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^7.3 || ^8.0",
        "illuminate/console": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Seadragon\\LaravelLogAlerts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Seadragon\\LaravelLogAlerts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Seadragon\\LaravelLogAlerts\\LogAlertServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0 || ^12.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
